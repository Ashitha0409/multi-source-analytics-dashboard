# ── Google Sheets API ─────────────────────────────────────────
# Go to Google Cloud Console > APIs & Services > Credentials
# Enable "Google Sheets API", generate an API Key and paste it here:
VITE_GOOGLE_SHEETS_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# ── Spreadsheet IDs ───────────────────────────────────────────
# Found in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
VITE_SHEET_ID_SALES=YOUR_SPREADSHEET_ID_HERE
VITE_SHEET_ID_USERS=YOUR_SPREADSHEET_ID_HERE
